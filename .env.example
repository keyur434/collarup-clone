APP_NAME=TalentPulse
APP_URL=http://localhost/collarup-clone/public
APP_ENV=local
APP_DEBUG=true
AUTH_ALLOW_LOCAL_LOGIN=true

DB_DRIVER=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=collarup_clone
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
# Optional: retries on transient SQL connect/login errors (Apache workers)
DB_CONNECT_RETRIES=3
DB_LOGIN_TIMEOUT=10
DB_TRUST_SERVER_CERTIFICATE=1

# Azure AD — Login app (delegated OAuth for SSO)
AZURE_AD_TENANT_ID=
AZURE_AD_LOGIN_CLIENT_ID=
AZURE_AD_LOGIN_CLIENT_SECRET=
AZURE_AD_LOGIN_REDIRECT_URI=

# Azure AD — Sync app (client credentials for Graph / OneDrive / Teams) — NOT the login app
AZURE_AD_SYNC_CLIENT_ID=
AZURE_AD_SYNC_CLIENT_SECRET=

# Shared OneDrive library (Graph drive ID + folder path)
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_PATH=/InterviewRecordings

# Teams meeting owner in Microsoft 365 (recordings live under this account)
TEAMS_ORGANIZER_USER_ID=hr@yourcompany.com

# Recruiters schedule in TalentPulse only — Graph creates meetings as TEAMS_ORGANIZER_USER_ID (no hr@ password needed)
TEAMS_SHARED_ORGANIZER=true

# Keka workflow: schedule in Keka, paste Teams join link in TalentPulse (recommended)
TEAMS_KEKA_REGISTER_MODE=true
TEAMS_AUTO_CREATE_MEETINGS=false
TEAMS_SHARED_ORGANIZER=false

# Minutes after calendar end before polling (first poll may be earlier — 30 min after start)
TEAMS_RECORDING_FETCH_BUFFER_MINUTES=5

# Show manual video upload in UI (default off for HR)
SHOW_MANUAL_VIDEO_UPLOAD=false

# Azure OpenAI / Foundry — PAID per token (see docs/PAID_API_SERVICES.md)
# Endpoint = resource root only (no /api/projects/... in this variable)
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_ENDPOINT_FALLBACKS=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
# Must match Portal → Deployments → *Deployment name* (not model SKU, not a UUID)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name-here
# Optional alias deployment name to try; leave empty if unsure
AZURE_OPENAI_DEPLOYMENT_ID=
# If models are under a Foundry project, set project name (not deployment UUID)
AZURE_OPENAI_FOUNDRY_PROJECT=
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=your-mini-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
# auto | v1 (Foundry) | classic (*.openai.azure.com)
AZURE_OPENAI_API_MODE=auto
AZURE_OPENAI_USE_BEARER=true
AZURE_OPENAI_REFINE_DEPLOYMENT=gpt-4.1-mini
REFINE_TRANSCRIPT=true
# multipass = Q&A extract + scoring (default) | legacy = single-pass
ANALYSIS_PIPELINE=multipass
# Third pass: audit scoring against transcript (reduces hallucination)
ANALYSIS_GROUNDING_PASS=true

# ElevenLabs Scribe v2 — STT
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_DIARIZE=true
ELEVENLABS_NUM_SPEAKERS=2
ELEVENLABS_DETECT_SPEAKER_ROLES=true
ELEVENLABS_TAG_AUDIO_EVENTS=false
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_KEYTERMS=

FFMPEG_PATH=ffmpeg

# Optional: Poppler PDF tools inside the project (see tools/poppler/README.md). No Apache PATH/restart needed.
# POPPLER_BIN_DIR=C:/Apache24/htdocs/collarup-clone/tools/poppler/bin

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@company.local
SMTP_FROM_NAME=TalentPulse

# Notification delivery: live | test | log
# live = real HM/interviewer inboxes
# test = all mail to NOTIFY_EMAIL_TEST_TO (subject prefixed [TEST])
# log = no SMTP; rows in notification_log only (dry_run)
NOTIFY_EMAIL_MODE=test
NOTIFY_EMAIL_TEST_TO=you@company.com

# Keka HR sync (optional)
KEKA_TENANT=
KEKA_API_BASE=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=

# Employee directory cache (HM/interviewer pickers), days
EMPLOYEE_DIRECTORY_CACHE_TTL_DAYS=7

# Preview hiring desk at /hiring-desk (off = hidden nav + 404 on routes)
HIRING_DESK_BETA=false
