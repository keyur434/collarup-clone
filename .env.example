APP_URL=http://localhost/collarup-clone/public
APP_ENV=local
APP_DEBUG=true
AUTH_ALLOW_LOCAL_LOGIN=true

DB_DRIVER=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=collarup_clone
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd

# Azure AD — Login app (delegated OAuth for SSO)
AZURE_AD_TENANT_ID=
AZURE_AD_LOGIN_CLIENT_ID=
AZURE_AD_LOGIN_CLIENT_SECRET=
AZURE_AD_LOGIN_REDIRECT_URI=

# Azure AD — Sync app (client credentials for Graph / OneDrive / Teams) — NOT the login app
AZURE_AD_SYNC_CLIENT_ID=
AZURE_AD_SYNC_CLIENT_SECRET=

# Shared OneDrive library (Graph drive ID + folder path)
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_PATH=/InterviewRecordings

# Teams recording fetch — organizer user email or Azure object ID
TEAMS_ORGANIZER_USER_ID=

# Azure OpenAI / Foundry — use services.ai.azure.com base (NOT /api/projects/... for chat)
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_ENDPOINT_FALLBACKS=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_ID=
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_MODE=auto
AZURE_OPENAI_USE_BEARER=true
AZURE_OPENAI_REFINE_DEPLOYMENT=gpt-4.1-mini
REFINE_TRANSCRIPT=true
# multipass = Q&A extract + scoring (default) | legacy = single-pass
ANALYSIS_PIPELINE=multipass

# ElevenLabs Scribe v2 — STT
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_DIARIZE=true
ELEVENLABS_NUM_SPEAKERS=2
ELEVENLABS_DETECT_SPEAKER_ROLES=false
ELEVENLABS_TAG_AUDIO_EVENTS=false
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_KEYTERMS=

FFMPEG_PATH=ffmpeg

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@company.local
SMTP_FROM_NAME=CollarUp Clone

# Keka HR sync (optional)
KEKA_TENANT=
KEKA_API_BASE=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
